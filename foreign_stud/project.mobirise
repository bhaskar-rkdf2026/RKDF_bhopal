          "testimonial": [
            {
              "text": "<p><b>STEP 1 &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</b><span style=\"font-size: 1.125rem; line-height: 2;\">Submit online application form, supporting all relevant information, at www.eduzina.com . A profile will be created and you will be mailed your login id and password.</span></p>",
              "media": {
                "image": {
                  "src": "@THEME_PATH@/components/_images/face3.jpg",
                  "class": "img-circle",
                  "height": 160,
                  "width": 160,
                  "active": true
                }
              },
              "authorName": "",
              "authorBio": "User"
            },
            {
              "text": "<p><b>STEP 2</b>&nbsp; &nbsp; &nbsp; &nbsp; Wait until you receive offer of admission from our university. A message will be sent to you to intimate announcement of result on your MY APPLICATION STATUS.</p>",
              "media": {
                "image": {
                  "src": "@THEME_PATH@/components/_images/face1.jpg",
                  "class": "img-circle",
                  "height": 160,
                  "width": 160,
                  "active": true
                }
              },
              "authorName": "",
              "authorBio": "User"
            },
            {
              "text": "<p><b>STEP 3</b>&nbsp; &nbsp; &nbsp; &nbsp; After receiving the offer letter, Pay registration fees USD 500 . For Bank Details ..</p>",
              "media": {
