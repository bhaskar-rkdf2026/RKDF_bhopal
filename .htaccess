
RewriteOptions inherit
RewriteEngine On

# ── CORS: Allow fonts and styles for subdomains ──
<IfModule mod_headers.c>
    <FilesMatch "\.(woff|woff2|eot|ttf|otf|svg|css|js)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept"
    </FilesMatch>
</IfModule>

# Disable Directory Index Browsing for Security
Options -Indexes

# Block Malicious / Spam Crawlers (Googlebot & Bingbot ALLOWED for SEO)
SetEnvIf User-Agent "BadBot" BlockBadBots
SetEnvIf User-Agent "AhrefsBot" BlockBadBots
SetEnvIf User-Agent "SemrushBot" BlockBadBots
SetEnvIf User-Agent "MJ12bot" BlockBadBots
SetEnvIf User-Agent "YandexBot" BlockBadBots
SetEnvIf User-Agent "DotBot" BlockBadBots
SetEnvIf User-Agent "Screaming Frog" BlockBadBots
SetEnvIf User-Agent "OpenLinkProfilerBot" BlockBadBots
SetEnvIf User-Agent "SpamBot" BlockBadBots
SetEnvIf User-Agent "Xenu Link Sleuth" BlockBadBots
SetEnvIf User-Agent "BLEXBot" BlockBadBots
SetEnvIf User-Agent "CreepBot" BlockBadBots
SetEnvIf User-Agent "SlurpBot" BlockBadBots
SetEnvIf User-Agent "Dotcom-Monitor" BlockBadBots
SetEnvIf User-Agent "SitelinerBot" BlockBadBots

<IfModule mod_authz_host.c>
    Deny from env=BlockBadBots
</IfModule>

# Redirect Legacy Subpages
RewriteRule ^homoeopathy$ "https://rkchms.in/" [R=301,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

